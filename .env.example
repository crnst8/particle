# particle configuration — every value is optional.
# Copy to .env and uncomment what you need:  cp .env.example .env

# HTTP port
#PORT=4747

# Where the SQLite file lives. In Docker this is inside the mounted volume.
#PARTICLE_DB=/app/data/particle.db

# Optional single-user password. Unset means authentication is off. Set this
# whenever particle is reachable from the public internet.
#PARTICLE_PASSWORD=

# Cookie signing key. If a password is set and this is left blank, particle
# generates one in the data directory. Set it explicitly for read-only setups.
#PARTICLE_SESSION_SECRET=

# Set to 1 behind nginx, Caddy or Traefik so secure cookies respect HTTPS.
#PARTICLE_TRUST_PROXY=0

# Mount the app below a URL path, for example /particle.
#PARTICLE_BASE=

# Network fetch protection. Private, loopback, link-local and reserved targets
# are blocked by default. Set to 1 only if you intentionally save LAN pages.
#ALLOW_PRIVATE_HOSTS=0

# Maximum response size accepted by the article image proxy (8 MiB).
#IMAGE_MAX_BYTES=8388608

# ── archive.today snapshots ─────────────────────────────────────────────────
# The mirrors are tried in this order when every other extraction route is
# paywalled, and when you paste an archive.is link directly.
#ARCHIVE_TODAY_HOSTS=archive.today,archive.ph,archive.is,archive.md,archive.li,archive.vn,archive.fo

# The mirrors rate-limit servers and answer with a captcha. Particle normally
# works around this by fetching the snapshot from your browser instead (with a
# panel in the reader when a human has to clear the captcha by hand). If you
# already hold a session cookie that gets the server through, set it here.
#ARCHIVE_TODAY_COOKIE=

# Maximum page source accepted back from the browser during that rescue — the
# "send page to particle" bookmarklet, or a paste into the reader panel (8 MiB).
#SNAPSHOT_MAX_BYTES=8388608

# ── Optional: AI tagging ─────────────────────────────────────────────────────
# With a key set, each saved article gets 1-3 topic tags and a completeness
# verdict (full / partial / stub). The title and excerpts from the article are
# sent to that endpoint; particle stores only tags/verdict and never rewrites
# article text. Leave unset and the feature is simply off.
#
# Works with any OpenAI-compatible /chat/completions endpoint, including a
# local Ollama:  LLM_API_URL=http://localhost:11434/v1/chat/completions
#LLM_API_KEY=
#LLM_API_URL=https://opencode.ai/zen/go/v1/chat/completions
#LLM_MODEL=deepseek-v4-flash

# The old OPENCODE_KEY / OPENCODE_API / OPENCODE_MODEL names remain accepted
# as compatibility aliases.

# ── Optional: narration (read aloud) ─────────────────────────────────────────
# With a key set, the reader grows a "listen" button. particle writes a spoken
# script from the extracted article — headings paced, quotes set apart, repeated
# pullquotes and code blocks left out, links read as domains — casts a voice from
# the provider's catalogue to suit the piece, and caches the mp3 next to the
# article so replaying costs nothing. Leave unset and the feature is simply off.
#
# A free Fish Audio key (model s2.1-pro-free) works: https://fish.audio
#TTS_API_KEY=
#TTS_API_URL=https://api.fish.audio/v1/tts
#TTS_MODEL_API_URL=https://api.fish.audio/model
#TTS_MODEL=s2.1-pro-free

# Pin one voice for every article; add TTS_VOICE_LOCK=1 to stop particle picking
# a different one per piece. Voice ids come from the provider's catalogue, which
# the reader lists under the player's "choose a voice".
#TTS_VOICE_ID=
#TTS_VOICE_LOCK=0

# 64 kbps mono mp3 is speech-clean and roughly 0.5 MB a minute. 128 and 192 also
# work and cost proportionally more disk.
#TTS_BITRATE=64
#TTS_LATENCY=normal

# How much of the article goes in one request, how many run at once, and how far
# ahead of playback synthesis runs.
#TTS_SEGMENT_CHARS=1100
#TTS_CONCURRENCY=2
#TTS_WARM_AHEAD=3

# Ceiling for cached narration audio. Past it, the least recently played
# narrations lose their audio; the script stays and re-synthesises on demand.
#TTS_MAX_CACHE_MB=512

# FISH_AUDIO_API and FISH_API_KEY are accepted as aliases for TTS_API_KEY.

# ── Public demo mode ────────────────────────────────────────────────────────
# Extraction-only server; the browser stores its own library in localStorage.
#DEMO_MODE=0
#DEMO_MAX_ARTICLES=15
#DEMO_SEED_URLS=demo/seed-urls.txt
#DEMO_EXTRACTS_PER_MINUTE=10

# Optional app-shell analytics injection. Leave unset for self-hosted installs.
#ANALYTICS_SRC=
#ANALYTICS_SITE_ID=
